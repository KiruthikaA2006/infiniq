# Synapse Environment Configuration Template

# 1. OpenAI API Credentials
# Provide your live OpenAI API key if you wish to run evaluation in Production Mode.
# If omitted or left blank, Synapse automatically falls back to the deterministic Mock Provider.
OPENAI_API_KEY=

# 2. AI Provider Selection Override
# Options: "llm" (forces OpenAI when key is present) or "mock" (forces local simulation fallback)
# Set to "mock" for local offline hackathon demo or automated testing assertions.
AI_PROVIDER=mock
